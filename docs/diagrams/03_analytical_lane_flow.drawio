        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;① Start&lt;br&gt;Conversation&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /genie/spaces/&lt;br&gt;{id}/start-conversation&lt;br&gt;&lt;br&gt;&lt;i&gt;Body: {content: prompt}&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;verticalAlign=middle;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;② Poll for&lt;br&gt;Completion&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET .../messages/{id}&lt;br&gt;every 2s until COMPLETED&lt;br&gt;&lt;br&gt;&lt;i&gt;Timeout: 60s&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="180" height="140" as="geometry" />
