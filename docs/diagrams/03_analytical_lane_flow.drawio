        <mxCell id="s3" value="&lt;b&gt;③ Extract&lt;br&gt;Results&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;From attachments:&lt;br&gt;• SQL → query.query&lt;br&gt;• Answer → text.content&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;arcSize=8;shadow=1;" vertex="1" parent="1">
