        <mxCell id="uc3" value="&lt;b&gt;UC3: Certification Flywheel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;User clicks &quot;Add to Review&quot; → corpus_service (submit_draft) → SME Review Page (edit SQL, run query) → Certify → SQL Validation → INSERT certified_qa_corpus → &lt;b&gt;sync_index()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;verticalAlign=middle;arcSize=8;shadow=0;" vertex="1" parent="1">
